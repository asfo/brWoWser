# Opt-in source distribution. Everything else stays local and untouched.
/*
!/README.md
!/CONTRIBUTING.md
!/.gitignore
!/.editorconfig
!/.clang-format
!/.prettierignore
!/.prettierrc.json
!/eslint.config.mjs
!/package.json
!/package-lock.json
!/pyproject.toml
!/requirements-dev.txt
!/app/
!/engine/
!/runtime/
!/tools/
!/config/
!/scripts/
!/docs/
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug_report.md

# Generated outputs, dependencies, private state and game content are not source.
**/build/
**/cache/
**/captures/
**/runs/
**/node_modules/
**/__pycache__/
**/.DS_Store
/engine/lua-runtime/tools/
/runtime/**/*.py
/runtime/**/*.md

# Legacy files are retained locally, outside the distributable project.
/app/client/*probe.mjs
/app/client/gpu_debug.mjs
/engine/simplehtml-trace/
/engine/login-ui/
/engine/screen-barrier/
/engine/login-material-passes/
/engine/login-soundscape/
/scripts/*
!/scripts/build_auth.mjs
!/scripts/network_bridge.mjs
!/scripts/x86_toolchain.mjs
!/scripts/client_profile.py
!/scripts/dev.mjs
!/scripts/restart_dev.mjs
!/scripts/code_style.py
!/scripts/repository_policy.py
/docs/*
!/docs/ARCHITECTURE.md
!/docs/DEPLOYMENT.md
!/docs/STATUS.md
!/docs/TODO.md
!/docs/KNOWN_ISSUES.md
!/docs/THIRD_PARTY.md

# Unused legacy helpers remain local.
/engine/archive-selection/browser-reader.mjs
/runtime/io/wasm_memory.mjs
/runtime/scene/particles_motion.mjs
